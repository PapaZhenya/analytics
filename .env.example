# Copy to .env and fill in real values. Never commit the real .env file.

# --- Postgres ---
POSTGRES_USER=callytics
POSTGRES_PASSWORD=change-me
POSTGRES_DB=callytics

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=20
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- CORS (comma-separated list consumed as JSON array by pydantic-settings) ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# --- Storage ---
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./.data/audio

# --- Frontend ---
FRONTEND_API_BASE_URL=http://localhost:8000/api/v1

# --- LLM providers (consumed by src/text/model.py via config/config.yaml's ${VAR} interpolation) ---
OPENAI_API_KEY=
HUGGINGFACE_TOKEN=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_BASE=
AZURE_OPENAI_API_VERSION=
