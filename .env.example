# Copy to .env and fill in real values. Never commit the real .env file.

# --- Postgres ---
POSTGRES_USER=callytics
POSTGRES_PASSWORD=change-me
POSTGRES_DB=callytics

# --- Auth ---
# REQUIRED — the app refuses to start without this (no hardcoded fallback secret;
# see backend/app/config.py). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=20
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- CORS (comma-separated list consumed as JSON array by pydantic-settings) ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# --- Storage ---
# "local" (default — plain filesystem, fine for development/single-box deployments) |
# "s3" (production option — real AWS S3 or any S3-compatible endpoint like MinIO)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./.data/audio
# Only read when STORAGE_BACKEND=s3:
STORAGE_S3_BUCKET=
STORAGE_S3_ENDPOINT_URL=
STORAGE_S3_REGION=us-east-1
# AWS credentials for S3 are picked up by boto3's standard chain (env vars below, an
# instance/task role, or ~/.aws/credentials) — not pydantic-settings fields, since boto3
# already has a well-established credential resolution order.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Frontend ---
FRONTEND_API_BASE_URL=http://localhost:8000/api/v1

# --- LLM provider selection ---
# "llama" (default, local — runs config/config.yaml's models.llama.model_name via
# transformers/torch on the worker, no data leaves this infrastructure at runtime) |
# "openai" (external API, opt-in only — nothing in this codebase selects it unless you
# set this) | "azure_openai" (currently BROKEN, see src/text/model.py::AzureOpenAIModel).
LLM_PROVIDER=llama

# --- LLM provider credentials (consumed by src/text/model.py via config/config.yaml's
# ${VAR} interpolation) ---
# HUGGINGFACE_TOKEN: only needed for LLM_PROVIDER=llama with a gated model (the default
# meta-llama/Llama-3.2-3B-Instruct requires accepting Meta's license on HuggingFace).
# This is a one-time model *download* credential, not a runtime API dependency — for a
# fully zero-external-credential deployment, swap models.llama.model_name in
# config/config.yaml to an ungated model instead.
HUGGINGFACE_TOKEN=
# OPENAI_API_KEY / AZURE_OPENAI_*: only read if LLM_PROVIDER is explicitly set to
# "openai" / "azure_openai" above. Leave empty for the default local-only deployment.
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_BASE=
AZURE_OPENAI_API_VERSION=

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR | CRITICAL. Output is structured JSON (one object per
# line, backend/app/logging_config.py) for both the api and worker processes.
LOG_LEVEL=INFO
